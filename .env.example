# ----------------------------------------------------------------------------
# Preeskahmour — environment
# Copy to `.env` and fill in. Only DATABASE_URL and AUTH_SECRET are required to
# run locally; everything else degrades gracefully into a documented mock mode.
# ----------------------------------------------------------------------------

# --- Database (required) ----------------------------------------------------
# Local:   postgresql://postgres:postgres@localhost:5432/preeskahmour?schema=public
# Neon:    postgresql://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/preeskahmour?sslmode=require
# Railway: copy the DATABASE_URL from the Postgres plugin's Connect tab
DATABASE_URL="postgresql://preeskahmour_user:9xcMZygtbDyFD300m3Y9tnTjZdtoDfKp@dpg-da6gb1942hec73d0jang-a.oregon-postgres.render.com/preeskahmour"

# --- Auth (required) --------------------------------------------------------
# Generate with:  openssl rand -base64 32
AUTH_SECRET="preeskahmour_secret"
AUTH_TRUST_HOST=true
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed credentials for the studio owner account (used by `npm run db:seed`).
SEED_ADMIN_EMAIL="prisca@preeskahmour.com"
SEED_ADMIN_PASSWORD="Preeskahmour.2026"

# --- Cloudinary (image uploads from /studio) --------------------------------
# Without these, /studio falls back to accepting pasted image URLs.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""

# --- Paystack (primary rail, NGN) -------------------------------------------
# Test keys from https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --- Stripe (secondary rail, USD) -------------------------------------------
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Display-only FX rate used to quote the USD (Stripe) rail from NGN prices.
NEXT_PUBLIC_NGN_PER_USD="1600"
